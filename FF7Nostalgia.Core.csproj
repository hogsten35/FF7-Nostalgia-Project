<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Scripts/**/*.cs" />
    <Compile Include="Tools/BattleHarness/Program.cs" />
    <Content Include="GameData/Act1/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>GameData/Act1/%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="GameData/Magic/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>GameData/Magic/%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="GameData/Summons/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>GameData/Summons/%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
